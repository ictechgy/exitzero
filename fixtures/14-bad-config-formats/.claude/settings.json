{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "prompt",
            "command": "echo wrong type"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./missing-script.sh"
          }
        ]
      }
    ],
    "Stop": []
  }
}
