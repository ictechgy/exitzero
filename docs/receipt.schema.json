{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "exitzero run receipt v1",
  "type": "object",
  "required": ["schema_version", "tool_version", "run_id", "started_at", "command", "hook_slot", "policy_sha256", "plugins", "inputs", "checks", "findings", "exit_code", "status", "duration_ms", "receipt"],
  "properties": {
    "schema_version": {"const": 1},
    "tool_version": {"type": "string"},
    "run_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "started_at": {"type": "string", "format": "date-time"},
    "command": {"enum": ["check", "lint-config", "doctor"]},
    "hook_slot": {"enum": [null, "PreToolUse", "PostToolUse", "pre-commit", "pre-push", "CI"]},
    "diff": {"type": "string", "description": "Git ref or range the check selection was narrowed against (--diff). Absent on unscoped runs."},
    "policy_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "plugins": {"type": "array", "items": {"type": "string"}},
    "inputs": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "checks": {"type": "array", "items": {"type": "object", "required": ["id", "kind", "status", "finding_count"], "properties": {
      "id": {"type": "string"}, "kind": {"type": "string"}, "status": {"enum": ["passed", "failed", "reused"]}, "finding_count": {"type": "integer", "minimum": 0},
      "enforcement": {"enum": ["block", "warn"]}, "blocking": {"type": "boolean"},
      "input_files": {"type": "array", "items": {"type": "string"}}, "reused_from": {"type": "string", "pattern": "^[a-f0-9]{32}$"}
    }, "additionalProperties": false,
    "allOf": [
      {"if": {"properties": {"status": {"const": "reused"}}},
       "then": {"required": ["input_files", "reused_from"]}},
      {"if": {"properties": {"status": {"enum": ["passed", "failed"]}}, "required": ["status"]},
       "then": {"not": {"required": ["reused_from"]}}}
    ]}},
    "requirements": {"type": "array", "items": {"type": "object", "required": ["id", "checks", "status"], "properties": {
      "id": {"type": "string"}, "checks": {"type": "array", "items": {"type": "string"}}, "status": {"enum": ["checks_passed", "failed", "unverified"]}
    }, "additionalProperties": false}},
    "diagnostics": {"type": "array", "description": "Project setup observations from doctor, not evidence of runtime enforcement.", "items": {
      "type": "object", "required": ["target", "state", "runtime", "path", "detail", "next_step"], "properties": {
        "target": {"type": "string", "minLength": 1, "description": "Client adapter, CI, permissions, or check.<id> for optional plugin setup diagnostics."},
        "state": {"enum": ["configured", "missing", "unmanaged", "misconfigured", "unknown"]},
        "runtime": {"const": "unverified"},
        "path": {"type": ["string", "null"]}, "detail": {"type": "string"}, "next_step": {"type": "string"}
      }, "additionalProperties": false
    }},
    "permissions": {"type":"object","description":"Change decisions under permission zones loaded from an independently supplied Git commit; not runtime sandbox evidence.","required":["base_commit","policy_sha256","status","changes","coverage","git_object_format"],"properties":{"base_commit":{"type":"string","pattern":"^([a-f0-9]{40}|[a-f0-9]{64})$"},"policy_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"status":{"enum":["passed","failed","unverified"]},"coverage":{"const":"tracked-and-unignored"},"git_object_format":{"enum":["sha1","sha256"]},"changes":{"type":"array","items":{"type":"object","required":["path","zone","decision","change","before_blob","after_sha256"],"properties":{"path":{"type":"string"},"zone":{"enum":["editable","protected","immutable","unclassified"]},"decision":{"enum":["allowed","review_required","denied"]},"change":{"enum":["added","deleted","modified"]},"before_blob":{"type":["string","null"],"pattern":"^([a-f0-9]{40}|[a-f0-9]{64})$"},"after_sha256":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"}},"additionalProperties":false}}},"additionalProperties":false},
    "findings": {"type": "array", "items": {"type": "object", "required": ["rule", "message", "path", "line", "severity"], "properties": {
      "rule": {"type": "string"}, "message": {"type": "string"}, "path": {"type": ["string", "null"]}, "line": {"type": ["integer", "null"], "minimum": 1}, "severity": {"enum": ["error", "warning"]},
      "category": {"enum": ["violation", "execution"]}
    }, "additionalProperties": false}},
    "exit_code": {"enum": [0, 1, 2]},
    "status": {"enum": ["passed", "failed", "error"]},
    "duration_ms": {"type": "number", "minimum": 0},
    "receipt": {"type": ["string", "null"]}
  },
  "additionalProperties": false,
  "allOf": [{"if": {"properties": {"command": {"const": "doctor"}}, "required": ["command"]},
             "then": {"required": ["diagnostics"]}}]
}
